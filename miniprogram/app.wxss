page{background:#FFF8EF;color:#514843;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.6;--cream:#FFF8EF;--pink:#F2B8C6;--mint:#D9EFE3;--ink:#514843}
.page{padding:28rpx 32rpx 56rpx}.eyebrow{color:#7B6C65;font-size:22rpx;letter-spacing:3rpx}.heading{font-size:48rpx;font-weight:700;line-height:1.3;letter-spacing:-1rpx}.subheading{font-size:34rpx;font-weight:650}.muted{color:#786B65;font-size:24rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.start{justify-content:flex-start}.wrap{flex-wrap:wrap}.gap{margin-top:24rpx}.small-gap{margin-top:12rpx}.card{background:#FFFEFB;border:1rpx solid #EDE3D9;border-radius:32rpx;padding:28rpx;margin-top:24rpx;box-shadow:0 8rpx 28rpx rgba(81,72,67,.035)}.mint{background:#D9EFE3;border-color:#C9E1D3}.pink{background:#FBE4EA;border-color:#F0CDD7}.selector{padding:10rpx 22rpx;background:#D9EFE3;border-radius:40rpx;font-weight:600;white-space:nowrap}.notice{padding:16rpx 22rpx;border-radius:18rpx;background:#F5EDE3;color:#75655C;font-size:23rpx;margin-top:20rpx}.error{background:#FAE0D9;color:#8D392F}.warning{background:#FFF0D9;color:#80541E}.badge{font-size:21rpx;padding:4rpx 14rpx;background:#D9EFE3;color:#355947;border-radius:24rpx;display:inline-block}.badge.pink{color:#865167;background:#FBE4EA}.badge.overdue{background:#FAE0D9;color:#8D392F}.badge.soon{background:#FBE4EA;color:#865167}.badge.done{background:#E9E9E4;color:#6C6C60}.stats{display:flex;gap:18rpx;margin-top:24rpx}.stat{flex:1;min-width:0;background:#FFF8EF;padding:18rpx 16rpx;border-radius:20rpx}.stat .number{font-size:40rpx;font-weight:700;line-height:1.35}.big-number{font-size:88rpx;font-weight:750;line-height:1.15;letter-spacing:-4rpx}.unit{font-size:24rpx;font-weight:400;letter-spacing:0}.progress{height:16rpx;background:#E8DACC;border-radius:16rpx;overflow:hidden;margin:22rpx 0}.progress-fill{height:100%;background:#A75F78;border-radius:16rpx}.divider{height:1rpx;background:#EEE1D8;margin:24rpx 0}.list-row{padding:18rpx 0;border-bottom:1rpx solid #EEE1D8}.list-row:last-child{border-bottom:0}.title{font-weight:650;font-size:28rpx}.empty{text-align:center;padding:36rpx 20rpx;color:#786B65}.emoji{font-size:42rpx}.tabs{display:flex;background:#F1E7DB;padding:8rpx;border-radius:24rpx;margin-top:24rpx;gap:6rpx}.tab{flex:1;padding:12rpx 0;text-align:center;border-radius:18rpx;color:#786B65}.tab.active{background:#F2B8C6;color:#514843;font-weight:650}.chips{display:flex;gap:12rpx;flex-wrap:wrap}.chip{padding:8rpx 20rpx;border-radius:30rpx;background:#F2EADF;color:#6B5E58}.chip.active{background:#D9EFE3;color:#355947}.label{font-size:25rpx;font-weight:600;margin:20rpx 0 9rpx;display:block}.input,.picker{box-sizing:border-box;width:100%;background:#FFF8EF;border:1rpx solid #E2D7CA;border-radius:18rpx;padding:18rpx 20rpx;min-height:78rpx;color:#514843}.input{height:80rpx}.textarea{height:190rpx;padding:18rpx;box-sizing:border-box;width:100%;background:#FFF8EF;border:1rpx solid #E2D7CA;border-radius:18rpx}.inline-fields{display:flex;gap:16rpx}.inline-fields>view{flex:1;min-width:0}button{font-size:27rpx;font-weight:650;line-height:1.4;padding:20rpx 24rpx;border-radius:20rpx;margin:0;color:#514843;box-shadow:none}button::after{border:0}.primary{background:#F2B8C6}.secondary{background:#D9EFE3}.ghost{background:#F1E9DF}.danger{background:#FAE0D9;color:#8D392F}.tiny{padding:9rpx 16rpx;font-size:23rpx;border-radius:16rpx}.link{font-size:24rpx;color:#855066;padding:8rpx;background:transparent}.actions{display:flex;gap:14rpx;flex-wrap:wrap;margin-top:24rpx}.actions button{flex:1}.check{display:flex;align-items:center;justify-content:space-between;padding:18rpx 0;gap:20rpx}.photos{display:flex;gap:12rpx;flex-wrap:wrap;margin-top:18rpx}.photo{width:180rpx;height:180rpx;border-radius:20rpx;background:#EEE6DC}.photo-wrap{position:relative}.remove-photo{position:absolute;right:5rpx;top:5rpx;background:#514843;color:#fff;border-radius:50%;width:36rpx;height:36rpx;text-align:center;line-height:36rpx}.chart{width:100%;height:280rpx}.form-section{padding-top:10rpx}.footnote{margin-top:28rpx;color:#786B65;font-size:22rpx;text-align:center}.mono{font-family:monospace;word-break:break-all}.mini-title{font-size:24rpx;font-weight:650;color:#786B65}.sticker{width:100rpx;height:100rpx;border-radius:30rpx;background:#FFF8EF;display:flex;align-items:center;justify-content:center;font-size:62rpx;transform:rotate(-6deg)}.meal-grid{display:flex;gap:20rpx}.meal-grid>view{flex:1}.ingredients-row{padding:16rpx;background:#FFF8EF;border-radius:20rpx;margin-top:14rpx}.source{font-size:22rpx;color:#786B65;margin-top:12rpx}
