<view class="page"><view class="row"><view><view class="eyebrow">OUR LITTLE FAMILY · 一起照顾</view><view class="heading">毛孩子档案</view></view><picker wx:if="{{pet}}" range="{{petNames}}" value="{{petIndex}}" bindchange="switchPet"><view class="selector">{{pet.name}} ⌄</view></picker></view><view class="notice">{{status}}</view><view wx:if="{{error}}" class="notice error">{{error}}</view><view class="tabs"><view class="tab {{tab==='pet'?'active':''}}" data-tab="pet" bindtap="tabChange">狗狗档案</view><view class="tab {{tab==='health'?'active':''}}" data-tab="health" bindtap="tabChange">健康计划</view><view class="tab {{tab==='family'?'active':''}}" data-tab="family" bindtap="tabChange">家人共用</view></view>
<block wx:if="{{tab==='pet'}}"><view wx:if="{{pet}}" class="card mint"><view class="row"><view><view class="heading">{{pet.name}}</view><view class="muted">{{pet.breed || '我们的毛孩子'}} · {{age}}</view></view><view class="sticker">🐶</view></view><view class="stats"><view class="stat"><view class="number">{{summary.weightText}}<text class="unit"> kg</text></view><view class="muted">最近称重</view></view><view class="stat"><view class="number">{{pet.meals}}<text class="unit"> 餐</text></view><view class="muted">每日餐数</view></view><view class="stat"><view class="number">{{pet.bodyCondition}}<text class="unit"> /9</text></view><view class="muted">体况评分</view></view></view><view class="muted gap">生日 {{pet.birthday}} · {{pet.stage==='puppy'?'幼犬':'成犬'}} · {{pet.neutered?'已绝育':'未绝育'}}</view><view class="actions"><button class="primary" bindtap="editPet">编辑档案 / 更新体重</button><button class="ghost" data-entity="pet" data-id="{{pet.id}}" bindtap="deleteRecord">归档</button></view></view><button class="secondary gap" bindtap="newPet">＋ 添加另一只狗狗</button>
<view wx:if="{{petEditing}}" class="card pink"><view class="subheading">{{petForm.id?'编辑档案':'新毛孩子'}}</view><view class="inline-fields"><view><text class="label">名字</text><input class="input" value="{{petForm.name}}" data-form="petForm" data-field="name" bindinput="fieldChange" placeholder="名字"/></view><view><text class="label">品种</text><input class="input" value="{{petForm.breed}}" data-form="petForm" data-field="breed" bindinput="fieldChange" placeholder="品种 / 混血"/></view></view><text class="label">生日</text><picker mode="date" value="{{petForm.birthday}}" end="{{date}}" data-form="petForm" data-field="birthday" bindchange="fieldChange"><view class="picker">{{petForm.birthday}} ⌄</view></picker><text class="label">成长阶段（由你确认）</text><picker range="{{stages}}" range-key="label" value="{{stageIndex}}" data-options="stages" data-form="petForm" data-field="stage" bindchange="fieldChange"><view class="picker">{{petForm.stage==='puppy'?'幼犬 · 成长中':'成犬 · 已确认成熟'}} ⌄</view></picker><view class="check"><text>已断奶</text><switch checked="{{petForm.weaned}}" color="#96546A" data-form="petForm" data-field="weaned" bindchange="fieldChange"/></view><view class="check"><text>已绝育</text><switch checked="{{petForm.neutered}}" color="#96546A" data-form="petForm" data-field="neutered" bindchange="fieldChange"/></view>
<view class="inline-fields"><view><text class="label">本次体重 kg</text><input class="input" type="digit" value="{{petForm.initialWeight}}" data-form="petForm" data-field="initialWeight" bindinput="fieldChange" placeholder="留空保留历史体重"/></view><view><text class="label">称重日期</text><picker mode="date" value="{{petForm.weightDate}}" end="{{date}}" data-form="petForm" data-field="weightDate" bindchange="fieldChange"><view class="picker">{{petForm.weightDate}}</view></picker></view></view><view class="inline-fields"><view><text class="label">体况评分 1—9</text><input class="input" type="number" value="{{petForm.bodyCondition}}" data-form="petForm" data-field="bodyCondition" bindinput="fieldChange"/></view><view><text class="label">每日餐数 1—8</text><input class="input" type="number" value="{{petForm.meals}}" data-form="petForm" data-field="meals" bindinput="fieldChange"/></view></view><text class="label">兽医指定热量 kcal / 天（可留空）</text><input class="input" type="digit" value="{{petForm.vetTarget}}" data-form="petForm" data-field="vetTarget" bindinput="fieldChange" placeholder="填写后优先采用此目标"/>
<text class="label">主粮选择</text><picker range="{{mainFoods}}" range-key="name" value="{{mainFoodIndex}}" bindchange="mainFoodChange"><view class="picker">{{mainFoods[mainFoodIndex].name}} ⌄</view></picker><text class="label">完整鲜食食谱</text><picker range="{{mainRecipes}}" range-key="name" value="{{mainRecipeIndex}}" bindchange="mainRecipeChange"><view class="picker">{{mainRecipes[mainRecipeIndex].name}} ⌄</view></picker><view class="inline-fields"><view><text class="label">主食中鲜食占比 %</text><input class="input" type="digit" value="{{petForm.freshPercent}}" data-form="petForm" data-field="freshPercent" bindinput="fieldChange"/></view><view><text class="label">预留加餐热量 %</text><input class="input" type="digit" value="{{petForm.snackPercent}}" data-form="petForm" data-field="snackPercent" bindinput="fieldChange"/></view></view><view class="source">鲜食占比按热量分配：0%为主粮，100%为完整鲜食。零食＋非完整鲜食合计上限为总热量的10%。</view><view class="actions"><button class="ghost" bindtap="cancelPet">取消</button><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="savePet">保存档案</button></view></view>
<view wx:if="{{archivedPets.length}}" class="card"><view class="subheading">已归档狗狗</view><view wx:for="{{archivedPets}}" wx:key="id" class="row list-row"><view>{{item.name}}<view class="muted">历史记录已保留</view></view><button class="secondary tiny" data-id="{{item.id}}" bindtap="restorePet">恢复档案</button></view></view><view class="card"><view class="mini-title">计算与使用依据</view><view class="source">RER = 70 × 体重kg^0.75。已断奶幼犬未满4个月乘3，满4个月乘2；成犬绝育默认乘1.6，未绝育乘1.8。初始估算需结合体重和体况调整。疾病、孕哺期等采用兽医目标。</view><view class="source">AAHA 2021 Nutrition and Weight Management Guidelines · WSAVA Feeding treats to your dog。鲜食主食按专业食谱及补充剂原样缩放。</view></view></block>
<block wx:if="{{tab==='health'}}"><view class="card mint"><view class="row"><view><view class="subheading">健康日历</view><view class="muted">按医院计划 / 药品周期照顾{{pet.name || '毛孩子'}}</view></view><text class="emoji">🗓</text></view><button class="secondary gap" bindtap="newHealth">＋ 添加疫苗 / 驱虫 / 体检</button><text class="label">标记完成时使用的实际日期</text><picker mode="date" value="{{completion.date}}" end="{{date}}" data-form="completion" data-field="date" bindchange="fieldChange"><view class="picker">{{completion.date}}</view></picker></view>
<view wx:for="{{plans}}" wx:key="id" class="card"><view class="row"><view><view class="badge">{{item.kindLabel}}</view><view class="subheading small-gap">{{item.name}}</view></view><text class="badge {{item.status.level}}">{{item.status.label}}</text></view><view class="muted gap">{{item.completedAt?'完成于 '+item.completedAt:'下次日期 '+item.dueDate}} {{item.dose}}</view><view wx:if="{{item.recordDate}}" class="muted">上次完成 {{item.recordDate}}</view><view class="muted">{{item.hospital}} {{item.product}}</view><view wx:if="{{item.notes}}" class="source">{{item.notes}}</view><view wx:if="{{item.repeatDays}}" class="source">周期 {{item.repeatDays}}天 · 提前 {{item.advanceDays}}天提示</view><view wx:if="{{item.calendarChanged}}" class="notice warning">⚠ 计划已变化，请在手机日历调整或删除旧事件后重新添加。</view><view wx:if="{{item.completedAt && item.calendarAdded}}" class="source">事项已完成；手机日历中的事件请手动处理。</view><view class="actions"><button wx:if="{{!item.completedAt}}" class="primary tiny" data-id="{{item.id}}" bindtap="completeHealth" disabled="{{busy}}">标记完成</button><button wx:if="{{!item.completedAt}}" class="secondary tiny" data-id="{{item.id}}" bindtap="addCalendar" disabled="{{item.calendarAdded}}">{{item.calendarAdded?'已添加日历':'添加手机日历'}}</button><button class="ghost tiny" data-id="{{item.id}}" bindtap="editHealth">编辑 / 附件</button></view><button class="link" data-entity="health" data-id="{{item.id}}" bindtap="deleteRecord">删除计划</button></view><view wx:if="{{!plans.length}}" class="card empty">录入医院给出的下一次日期，提醒就会出现在这里。</view>
<view wx:if="{{healthEditing}}" class="card pink"><view class="subheading">{{healthForm.id?'编辑健康事项':'新健康事项'}}</view><text class="label">类型</text><picker range="{{healthKinds}}" range-key="label" value="{{kindIndex}}" data-options="healthKinds" data-form="healthForm" data-field="kind" bindchange="fieldChange"><view class="picker">{{healthForm.kind==='vaccine'?'疫苗':healthForm.kind==='internal'?'体内驱虫':healthForm.kind==='external'?'体外驱虫':'体检'}} ⌄</view></picker><text class="label">名称</text><input class="input" value="{{healthForm.name}}" data-form="healthForm" data-field="name" bindinput="fieldChange" placeholder="例如：疫苗第三针"/><view class="inline-fields"><view><text class="label">上次完成日期（可选）</text><picker mode="date" value="{{healthForm.recordDate}}" end="{{date}}" data-form="healthForm" data-field="recordDate" bindchange="fieldChange"><view class="picker">{{healthForm.recordDate || '未填写'}}</view></picker></view><view><text class="label">下次计划日期</text><picker mode="date" value="{{healthForm.dueDate}}" data-form="healthForm" data-field="dueDate" bindchange="fieldChange"><view class="picker">{{healthForm.dueDate}}</view></picker></view></view><view wx:if="{{healthForm.kind!=='vaccine'}}"><text class="label">已确认的周期天数（可留空）</text><input class="input" type="number" value="{{healthForm.repeatDays}}" data-form="healthForm" data-field="repeatDays" bindinput="fieldChange" placeholder="按药品或医院要求填写"/><button class="link" bindtap="calculateNext">按上次日期＋周期计算下次日期</button></view><text wx:if="{{healthForm.kind==='vaccine'}}" class="label">针次</text><input wx:if="{{healthForm.kind==='vaccine'}}" class="input" value="{{healthForm.dose}}" data-form="healthForm" data-field="dose" bindinput="fieldChange" placeholder="第几针 / 加强针"/><text class="label">医院</text><input class="input" value="{{healthForm.hospital}}" data-form="healthForm" data-field="hospital" bindinput="fieldChange" placeholder="医院名称（可选）"/><text class="label">疫苗 / 驱虫产品</text><input class="input" value="{{healthForm.product}}" data-form="healthForm" data-field="product" bindinput="fieldChange" placeholder="产品名称（可选）"/><text class="label">提前提醒天数</text><input class="input" type="number" value="{{healthForm.advanceDays}}" data-form="healthForm" data-field="advanceDays" bindinput="fieldChange"/><text class="label">备注</text><textarea class="textarea" maxlength="1000" value="{{healthForm.notes}}" data-form="healthForm" data-field="notes" bindinput="fieldChange" placeholder="医院建议、用药注意、检查结果…"/><view class="photos"><view wx:for="{{healthPhotoUrls}}" wx:key="index" class="photo-wrap"><image class="photo" src="{{item}}" mode="aspectFill" data-photos="{{healthForm.attachments}}" data-index="{{index}}" bindtap="previewPhoto"/><view class="remove-photo" data-index="{{index}}" bindtap="removeAttachment">×</view></view></view><button class="secondary gap" loading="{{attachmentBusy}}" disabled="{{attachmentBusy || healthForm.attachments.length>=9}}" bindtap="addAttachments">📎 {{pendingAttachmentCount ? "重试未上传附件" : "添加接种单 / 检查报告照片"}}</button><view class="actions"><button class="ghost" bindtap="cancelHealth">取消</button><button class="primary" loading="{{busy}}" disabled="{{busy || attachmentBusy}}" bindtap="saveHealth">保存健康计划</button></view></view></block>
<block wx:if="{{tab==='family'}}"><view class="card mint"><view class="subheading">{{family.name}}</view><view class="muted">每个人都能知道，刚刚是谁喂过了。</view><picker wx:if="{{familyOptions.length>1}}" range="{{familyOptions}}" range-key="name" value="{{familyIndex}}" bindchange="familyChange"><view class="picker gap">切换家庭：{{familyOptions[familyIndex].name}} ⌄</view></picker><view wx:for="{{family.members}}" wx:key="id" class="row list-row"><view><view class="title">{{item.name}}{{item.id===currentUser.id?'（我）':''}}</view><text class="muted">{{item.admin?'管理员':'共同照顾者'}}</text></view><button wx:if="{{currentUser.admin && item.id!==currentUser.id}}" class="link" data-id="{{item.id}}" bindtap="removeMember">移除</button><button wx:if="{{isDemo && item.id!==currentUser.id}}" class="ghost tiny" data-id="{{item.id}}" bindtap="demoActor">模拟此人记录</button></view></view><view class="card"><view class="subheading">我在家里的名字</view><input class="input gap" value="{{memberForm.name}}" data-form="memberForm" data-field="name" bindinput="fieldChange" maxlength="30"/><button class="primary gap" bindtap="saveNickname" disabled="{{busy}}">保存昵称</button></view>
<view wx:if="{{currentUser.admin}}" class="card pink"><view class="subheading">邀请家人一起记</view><view class="muted">邀请码48小时内有效，仅能使用一次。</view><button class="primary gap" bindtap="createInvite">生成邀请码</button><block wx:if="{{inviteCode}}"><view class="mono gap">{{inviteCode}}</view><view class="actions"><button class="secondary" bindtap="copyInvite">复制邀请码</button><button class="primary" open-type="share">分享给家人</button></view></block></view><view class="card"><view class="subheading">加入家人的家庭</view><input class="input gap mono" value="{{joinForm.code}}" data-form="joinForm" data-field="code" bindinput="fieldChange" placeholder="粘贴家人给你的邀请码"/><button class="secondary gap" bindtap="joinFamily" disabled="{{busy}}">加入并切换家庭</button></view><view wx:if="{{isDemo}}" class="notice">本机演示可模拟家人记账；真实跨设备协作需接入云开发。</view><button wx:if="{{isDemo}}" class="ghost gap" bindtap="resetDemo">重置本机演示数据</button></block><view class="footnote">一家人，一起把毛孩子照顾好 🐾</view></view>
