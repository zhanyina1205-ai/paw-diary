<view class="page"><view class="row"><view><view class="eyebrow">LITTLE MOMENTS · 一点点长大</view><view class="heading">毛孩子成长手账</view></view><picker wx:if="{{pet}}" range="{{petNames}}" value="{{petIndex}}" bindchange="switchPet"><view class="selector">{{pet.name}} ⌄</view></picker></view><view class="notice">{{status}}</view><view wx:if="{{error}}" class="notice error">{{error}}</view><view wx:if="{{!pet}}" class="card empty"><text>先添加狗狗，就能开始记日记。</text><button class="primary gap" bindtap="goProfile">添加狗狗</button></view>
<block wx:if="{{pet}}"><view class="card mint"><view class="row"><view><view class="subheading">{{pet.name}} · {{age}}</view><view class="muted">最新体重 {{summary.weightText}} kg</view></view><text class="emoji">🌱</text></view><canvas wx:if="{{weightCount}}" canvas-id="weight-chart" id="weight-chart" class="chart"></canvas><view wx:else class="empty">记下第一次称重，看看成长的轨迹。</view><view class="source">最近30个称重日期 · 同日多个记录显示最后保存的一项 · kg</view></view>
<button class="primary gap" bindtap="newEntry">＋ 记录今天的小可爱</button>
<view wx:if="{{diaryEditing}}" class="card pink"><view class="subheading">{{form.id?'编辑这一天':'写一页成长日记'}}</view><text class="label">记录日期</text><picker mode="date" value="{{form.date}}" end="{{date}}" data-field="date" bindchange="fieldChange"><view class="picker">{{form.date}} ⌄</view></picker><text class="label">今天的小故事</text><textarea class="textarea" maxlength="4000" value="{{form.text}}" data-field="text" bindinput="fieldChange" placeholder="第一次学会坐下、散步的新朋友…"/><view class="photos"><view wx:for="{{formPhotoUrls}}" wx:key="index" class="photo-wrap"><image class="photo" src="{{item}}" mode="aspectFill" data-photos="{{form.photos}}" data-index="{{index}}" bindtap="previewPhoto"/><view class="remove-photo" data-index="{{index}}" bindtap="removePhoto">×</view></view></view><button wx:if="{{form.photos.length<9}}" class="secondary gap" loading="{{photoBusy}}" disabled="{{photoBusy}}" bindtap="addPhotos">📷 {{pendingPhotoCount ? "重试未上传照片" : "添加照片"}}（{{form.photos.length}} / 9）</button><text class="label">体重 kg（可留空）</text><input class="input" type="digit" value="{{form.weight}}" data-field="weight" bindinput="fieldChange" placeholder="同一天的称重会进入成长曲线"/>
<view class="inline-fields"><view><text class="label">便便状态</text><picker range="{{stools}}" range-key="label" value="{{stoolIndex}}" data-options="stools" data-field="stool" bindchange="fieldChange"><view class="picker">{{form.stool || '未记录'}} ⌄</view></picker></view><view><text class="label">颜色</text><picker range="{{colors}}" range-key="label" value="{{colorIndex}}" data-options="colors" data-field="color" bindchange="fieldChange"><view class="picker">{{form.color || '未记录'}} ⌄</view></picker></view></view><text class="label">异常或观察备注</text><input class="input" value="{{form.abnormal}}" data-field="abnormal" bindinput="fieldChange" placeholder="例如：今天比平时软，食欲正常"/><view class="actions"><button class="ghost" bindtap="cancel">取消</button><button class="primary" loading="{{busy}}" disabled="{{busy || photoBusy}}" bindtap="saveDiary">保存这一页</button></view></view>
<view wx:for="{{entries}}" wx:key="id" class="card"><view class="row"><view><view class="eyebrow">{{item.date}}</view><view class="muted">{{item.actorName}} 记录</view></view><button class="link" data-id="{{item.id}}" bindtap="editEntry">编辑</button></view><view class="gap" style="white-space:pre-wrap">{{item.text}}</view><view class="photos"><image wx:for="{{item.photoUrls}}" wx:for-item="photo" wx:for-index="photoIndex" wx:key="*this" class="photo" src="{{photo}}" mode="aspectFill" data-photos="{{item.photos}}" data-index="{{photoIndex}}" bindtap="previewPhoto"/></view><view class="chips gap"><text wx:if="{{item.weight}}" class="badge">⚖ {{item.weight}} kg</text><text wx:if="{{item.stool}}" class="badge pink">便便 · {{item.stool}}</text><text wx:if="{{item.color}}" class="badge">{{item.color}}</text></view><view wx:if="{{item.abnormal}}" class="notice">观察：{{item.abnormal}}</view><button class="link small-gap" data-entity="diary" data-id="{{item.id}}" bindtap="deleteRecord">删除这一页</button></view><view wx:if="{{!entries.length}}" class="card empty">第一张照片，第一段故事，从今天开始。</view><view class="footnote">留住小小的日常，陪你慢慢长大 🐾</view></block></view>
