<view class="page"><view class="row"><view><view class="eyebrow">EAT WELL · 每一口都有数</view><view class="heading">喂食小账本</view></view><picker wx:if="{{pet}}" range="{{petNames}}" value="{{petIndex}}" bindchange="switchPet"><view class="selector">{{pet.name}} ⌄</view></picker></view><view class="notice">{{status}}</view><view wx:if="{{error}}" class="notice error">{{error}}</view>
<view class="tabs"><view class="tab {{tab==='log'?'active':''}}" data-tab="log" bindtap="tabChange">记进食</view><view class="tab {{tab==='foods'?'active':''}}" data-tab="foods" bindtap="tabChange">食品柜</view><view class="tab {{tab==='recipes'?'active':''}}" data-tab="recipes" bindtap="tabChange">鲜食厨房</view></view>
<block wx:if="{{tab==='log'}}"><view wx:if="{{!pet}}" class="card empty"><text>先为毛孩子建一个档案吧。</text><button class="primary gap" bindtap="goProfile">添加狗狗</button></view><block wx:else>
<view class="card mint"><view class="row"><view><view class="mini-title">今天已吃</view><view class="subheading">{{summary.fedText}} / {{summary.targetText}} kcal</view></view><view><view class="mini-title">加餐上限</view><view>{{summary.snackText}} / {{summary.snackLimitText}} kcal</view></view></view><view class="muted small-gap">{{summary.snackStatus}} · {{summary.incomplete?'统计不完整':'按实际进食累计'}}</view></view>
<view class="card"><view class="subheading">＋ 刚刚吃了什么</view><view class="inline-fields"><view><text class="label">日期</text><picker mode="date" value="{{form.date}}" end="{{date}}" data-field="date" bindchange="fieldChange"><view class="picker">{{form.date}}</view></picker></view><view><text class="label">时间</text><picker mode="time" value="{{form.time}}" data-field="time" bindchange="fieldChange"><view class="picker">{{form.time}}</view></picker></view></view>
<text class="label">食物或食谱</text><picker range="{{itemNames}}" value="{{itemIndex}}" bindchange="itemChange"><view class="picker">{{itemNames[itemIndex] || '先到食品柜添加食物'}} ⌄</view></picker><text class="label">实际吃下的数量（{{itemUnit}}）</text><input class="input" type="digit" value="{{form.amount}}" placeholder="称一称，再记一笔" data-field="amount" bindinput="fieldChange" disabled="{{busy}}"/><view class="source">食谱按标注的生重 / 熟重口径记录。保存前会读取家人最新记录。</view><button class="primary gap" loading="{{busy || preparingFeed}}" disabled="{{busy || preparingFeed || !items.length}}" bindtap="saveFeed">保存进食记录</button></view>
<view class="card"><view class="row"><view class="subheading">进食记录</view><picker mode="date" value="{{logDate}}" end="{{date}}" bindchange="logDateChange"><text class="badge">{{logDate}} ⌄</text></picker></view><view wx:for="{{logs}}" wx:key="id" class="list-row"><view class="row"><view><view class="title">{{item.snapshot.name}}</view><view class="muted">{{item.time}} · {{item.actorName}} · {{item.amount}}{{item.snapshot.unit}}</view></view><text>{{item.caloriesText}} kcal</text></view><view class="row small-gap"><text class="muted">{{item.snapshot.role==='main'?'完整主食':'零食 / 加餐'}}{{item.snapshot.recipeVersion?' · 食谱v'+item.snapshot.recipeVersion:''}}</text><button class="link" data-entity="feeding" data-id="{{item.id}}" bindtap="deleteRecord">删除</button></view></view><view wx:if="{{!logs.length}}" class="empty">这一天还没有进食记录。</view></view></block></block>
<block wx:if="{{tab==='foods'}}"><view class="card"><view class="row"><view class="subheading">家里的食品柜</view><button class="secondary tiny" bindtap="newFood">＋ 添加</button></view><view wx:for="{{foods}}" wx:key="id" class="list-row"><view class="row"><view><view class="title">{{item.name}}</view><view class="muted">{{item.energyText}} {{item.unitLabel}} · {{item.complete?'完整营养':'非完整营养'}}</view></view><button class="link" data-id="{{item.id}}" bindtap="editFood">编辑</button></view><button class="link" data-entity="food" data-id="{{item.id}}" bindtap="deleteRecord">删除食物</button></view><view wx:if="{{!foods.length}}" class="empty">按包装标注录入常吃的主粮和零食。</view></view>
<view wx:if="{{foodEditing}}" class="card pink"><view class="subheading">{{foodForm.id?'编辑食品':'添加食品'}}</view><text class="label">名称</text><input class="input" value="{{foodForm.name}}" data-form="foodForm" data-field="name" bindinput="fieldChange" placeholder="例如：幼犬粮 / 训练零食"/><view class="inline-fields"><view><text class="label">包装热量</text><input class="input" type="digit" value="{{foodForm.energy}}" data-form="foodForm" data-field="energy" bindinput="fieldChange" placeholder="未知可留空"/></view><view><text class="label">热量单位</text><picker range="{{units}}" range-key="label" value="{{foodUnitIndex}}" data-options="units" data-form="foodForm" data-field="unit" bindchange="fieldChange"><view class="picker">{{foodForm.unit==='kcalkg'?'kcal / kg':foodForm.unit==='kcalpiece'?'kcal / 个':'kcal / 100g'}} ⌄</view></picker></view></view><text class="label">用途</text><picker range="{{roles}}" range-key="label" value="{{roleIndex}}" data-options="roles" data-form="foodForm" data-field="role" bindchange="fieldChange"><view class="picker">{{foodForm.role==='main'?'主粮':foodForm.role==='treat'?'零食':'加餐'}} ⌄</view></picker><view class="check"><text>包装标明适用犬龄的完整营养食品</text><switch color="#96546A" checked="{{foodForm.complete}}" data-form="foodForm" data-field="complete" bindchange="fieldChange"/></view><view class="actions"><button class="ghost" bindtap="cancelFood">取消</button><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="saveFood">保存食品</button></view></view></block>
<block wx:if="{{tab==='recipes'}}"><view class="card mint"><view class="row"><view><view class="subheading">鲜食厨房</view><view class="muted">食谱配比 · 备餐清单 · 热量有数</view></view><text class="emoji">🥣</text></view><view class="source">专业主食按原食谱保留食材、称重口径及补充剂；自由搭配按加餐记录。</view><button class="secondary gap" bindtap="newRecipe">＋ 录入一份食谱</button></view>
<view wx:for="{{recipes}}" wx:key="id" class="card"><view class="row"><view><view class="title">{{item.name}}</view><view class="muted">整份 {{item.energyText}} kcal · {{item.basis==='raw'?'烹饪前生重':'食材熟重'}} · v{{item.version}}</view></view><button class="link" data-id="{{item.id}}" bindtap="editRecipe">编辑</button></view><view class="badge small-gap">{{item.status}}</view><view wx:if="{{item.source}}" class="source">来源：{{item.source}}</view><button class="link" data-entity="recipe" data-id="{{item.id}}" bindtap="deleteRecord">删除食谱</button></view>
<view wx:if="{{recipeEditing}}" class="card pink"><view class="subheading">{{recipeForm.id?'编辑食谱':'新食谱'}}</view><text class="label">食谱名称</text><input class="input" value="{{recipeForm.name}}" data-form="recipeForm" data-field="name" bindinput="fieldChange" placeholder="给这份食谱起个名字"/><text class="label">用途</text><picker range="{{purposes}}" range-key="label" value="{{purposeIndex}}" data-options="purposes" data-form="recipeForm" data-field="purpose" bindchange="fieldChange"><view class="picker">{{recipeForm.purpose==='main'?'专业完整主食':'鲜食加餐'}} ⌄</view></picker><text class="label">来源 / 营养师 / 审核日期</text><input class="input" value="{{recipeForm.source}}" data-form="recipeForm" data-field="source" bindinput="fieldChange" placeholder="主食请填写专业食谱来源"/>
<text class="label">适用成长阶段</text><checkbox-group bindchange="stageChange"><view class="row start"><label><checkbox value="puppy" checked="{{recipeForm.stages[0]==='puppy' || recipeForm.stages[1]==='puppy'}}" color="#96546A"/>幼犬</label><label><checkbox value="adult" checked="{{recipeForm.stages[0]==='adult' || recipeForm.stages[1]==='adult'}}" color="#96546A"/>成犬</label></view></checkbox-group>
<text class="label">食材称重口径</text><picker range="{{bases}}" range-key="label" value="{{basisIndex}}" data-options="bases" data-form="recipeForm" data-field="basis" bindchange="fieldChange"><view class="picker">{{recipeForm.basis==='raw'?'烹饪前生重（不代表生食）':'食材熟重'}} ⌄</view></picker><text class="label">整份食谱热量（kcal）</text><input class="input" type="digit" value="{{recipeForm.batchEnergy}}" data-form="recipeForm" data-field="batchEnergy" bindinput="fieldChange" placeholder="可留空，按每项食材热量相加"/>
<view class="row gap"><view class="title">基础份量中的食材</view><button class="secondary tiny" bindtap="addIngredient">＋ 食材</button></view><view wx:for="{{recipeForm.ingredients}}" wx:key="index" class="ingredients-row"><view class="row"><text class="mini-title">食材 {{index+1}}</text><button class="link" data-index="{{index}}" bindtap="removeIngredient">移除</button></view><input class="input" value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="ingredientField" placeholder="食材名称"/><view class="inline-fields small-gap"><view><input class="input" type="digit" value="{{item.grams}}" data-index="{{index}}" data-field="grams" bindinput="ingredientField" placeholder="基础克数 g"/></view><view><input class="input" type="digit" value="{{item.energy}}" data-index="{{index}}" data-field="energy" bindinput="ingredientField" placeholder="kcal / 100g"/></view></view></view>
<view class="row gap"><view class="title">补充剂（按原专业食谱）</view><button class="secondary tiny" bindtap="addSupplement">＋ 补充剂</button></view><view wx:for="{{recipeForm.supplements}}" wx:key="index" class="ingredients-row"><input class="input" value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="supplementField" placeholder="补充剂名称 / 规格"/><view class="inline-fields small-gap"><view><input class="input" type="digit" value="{{item.amount}}" data-index="{{index}}" data-field="amount" bindinput="supplementField" placeholder="基础用量"/></view><view><input class="input" value="{{item.unit}}" data-index="{{index}}" data-field="unit" bindinput="supplementField" placeholder="单位：g / mg 等"/></view></view><button class="link" data-index="{{index}}" bindtap="removeSupplement">移除补充剂</button></view>
<view wx:if="{{recipeForm.purpose==='main'}}" class="check"><text>我确认该完整食谱经专业审核，适用所选犬龄</text><switch checked="{{recipeForm.verified}}" color="#96546A" data-form="recipeForm" data-field="verified" bindchange="fieldChange"/></view><view wx:if="{{recipeForm.id && recipeForm.purpose==='main'}}" class="check"><text>本次修改后的食材和补充剂已重新确认专业审核</text><switch checked="{{recipeForm.reconfirm}}" color="#96546A" data-form="recipeForm" data-field="reconfirm" bindchange="fieldChange"/></view><view class="actions"><button class="ghost" bindtap="cancelRecipe">取消</button><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="saveRecipe">保存食谱</button></view></view>
<view wx:if="{{recipes.length}}" class="card"><view class="subheading">算一份备餐清单</view><text class="label">选择食谱</text><picker range="{{recipes}}" range-key="name" value="{{prepIndex}}" bindchange="prepRecipeChange"><view class="picker">{{recipes[prepIndex].name}} ⌄</view></picker><view class="inline-fields"><view><text class="label">每天分配热量 kcal</text><input class="input" type="digit" value="{{prep.calories}}" data-form="prep" data-field="calories" bindinput="fieldChange"/></view><view><text class="label">备餐天数</text><input class="input" type="number" value="{{prep.days}}" data-form="prep" data-field="days" bindinput="fieldChange"/></view></view><button class="link" bindtap="useSuggested">使用档案中的鲜食 / 加餐预算</button><button class="primary gap" bindtap="makePrep">生成食材与补充剂清单</button><view wx:if="{{prepWarning}}" class="notice warning">{{prepWarning}}</view><view wx:if="{{prepResult}}"><view class="divider"></view><view class="title">{{prepResult.name}} · {{prepResult.days}}天</view><view class="muted">{{prepResult.basisLabel}} · 食材共 {{prepResult.totalGrams}}g · {{prepResult.totalCalories}} kcal</view><view wx:for="{{prepResult.ingredients}}" wx:key="index" class="row list-row"><text>{{item.name}} <text class="muted">{{item.percent}}%</text></text><text>{{item.grams}}g</text></view><view wx:for="{{prepResult.supplements}}" wx:key="index" class="row list-row"><text>{{item.name}}</text><text>{{item.amount}}{{item.unit}}</text></view><view class="source">保留补充剂及原食谱称重口径；按实际分装量记录进食。</view><button class="secondary gap" bindtap="copyPrep">复制备餐清单</button></view></view></block></view>
